# Legible GitHub App — copy to .env and fill in.

# From the App's settings page (Developer settings → GitHub Apps).
APP_ID=123456

# The webhook secret you set when creating the App (use a long random string).
WEBHOOK_SECRET=change-me-to-a-long-random-string

# The App's private key. Either point at the downloaded .pem file…
PRIVATE_KEY_PATH=./legible-app.private-key.pem
# …or inline it (escape newlines as \n):
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# Port the webhook server listens on.
PORT=3000
